# Example environment variables for PG Buddy
# Copy values into Render's Environment or a local .env file (DO NOT commit secrets).

# Secret key for Flask sessions
PG_BUDDY_SECRET=replace-me-with-a-strong-secret

# Set to 0 in production; Render should set FLASK_DEBUG if needed
FLASK_DEBUG=0

# Render sets PORT automatically; you may override locally
PORT=5000

# Optional: toggle verbose logging
LOG_LEVEL=info
